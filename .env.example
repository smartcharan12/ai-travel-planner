# Copy this file to .env and fill in real values:   cp .env.example .env
# .env is git-ignored. NEVER commit real keys.
# New variables are added here as each build stage needs them.

# ---------- Application ----------
APP_ENV=local                 # local | test | dev | prod   (prod refuses DEMO_MODE, text logs, CORS "*")
LOG_LEVEL=INFO
LOG_FORMAT=json               # json (for Logstash / Cloud Logging) | text (readable locally)
LOG_FILE=                     # optional extra JSON log file; docker-compose sets /var/log/app/app.jsonl

# ---------- Demo mode ----------
# true = offline, keyless, INVENTED sample data (clearly labelled DEMO in every response).
# The app never switches to demo data on its own when a key is missing.
DEMO_MODE=false

# ---------- LLM: Gemini ----------
# Key: https://aistudio.google.com/apikey  (free tier available)
LLM_PROVIDER=gemini           # gemini | fake   (fake only together with SEARCH_PROVIDER=mock)
LLM_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
RESEARCH_TEMPERATURE=0.0      # extraction copies facts: no creativity
LLM_TEMPERATURE=0.3           # itinerary planning: a little variety in arranging days
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2             # SDK retries for network/5xx errors
LLM_OUTPUT_RETRIES=1          # re-asks when the model returns invalid JSON
# Optional, ONLY for cost estimates in logs (USD per 1M tokens). Copy current prices from the
# provider's pricing page; leave empty to log estimated_cost_usd=null instead of a stale guess.
LLM_INPUT_COST_PER_MILLION_USD=
LLM_OUTPUT_COST_PER_MILLION_USD=

# ---------- Real-time search ----------
# Tavily key: https://app.tavily.com   |   Serper key: https://serper.dev
SEARCH_PROVIDER=tavily        # tavily | serper | mock   (mock only together with LLM_PROVIDER=fake)
TAVILY_API_KEY=
SERPER_API_KEY=
SEARCH_TIMEOUT_SECONDS=15
SEARCH_MAX_RESULTS=5
TAVILY_SEARCH_DEPTH=basic     # basic (1 credit) | advanced (2 credits)
SEARCH_MAX_CONTENT_CHARS=1200

# ---------- Research ----------
MAX_ENTITIES_PER_CATEGORY=8

# ---------- Itinerary planning ----------
MAX_REPAIR_ATTEMPTS=2         # validator -> LLM repair rounds before giving up (ITINERARY_INVALID)

# ---------- Frontend (Streamlit) ----------
API_BASE_URL=http://localhost:8000

# ---------- Evaluation (python -m evaluation.runner) ----------
EVAL_JUDGE_MODEL=             # judge model for LLM-as-judge metrics; empty = LLM_MODEL (self-preference bias!)

# ---------- HTTP protection (Stage 5) ----------
CORS_ALLOW_ORIGINS=           # comma-separated browser origins; empty = CORS off (the UI calls the API server-side)
RATE_LIMIT_PER_MINUTE=20      # per client on /plan and /research; 0 = off
MAX_CONCURRENT_PLANS=8        # per replica; extra requests get 429 "busy"

# ---------- Secrets from files (GKE + Secret Manager) ----------
SECRETS_DIR=                  # e.g. /var/secrets: one file per variable (GEMINI_API_KEY, TAVILY_API_KEY)
