# Copy this file to .env and fill in real values:   cp .env.example .env
# .env is git-ignored. NEVER commit real keys.
# New variables are added here as each build stage needs them.

# ---------- Application ----------
APP_ENV=local                 # local | dev | prod
LOG_LEVEL=INFO

# ---------- LLM (used from Stage 2) ----------
# Gemini key: https://aistudio.google.com/apikey
LLM_PROVIDER=gemini           # gemini | fake   (fake = offline demo/tests only)
LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=
LLM_TEMPERATURE=0.3
LLM_TIMEOUT_SECONDS=60

# ---------- Real-time search (used from Stage 2) ----------
# Tavily key: https://app.tavily.com   |   Serper key: https://serper.dev
SEARCH_PROVIDER=tavily        # tavily | serper | mock   (mock = offline demo/tests only)
TAVILY_API_KEY=
SERPER_API_KEY=
SEARCH_TIMEOUT_SECONDS=15
SEARCH_MAX_RESULTS=5
